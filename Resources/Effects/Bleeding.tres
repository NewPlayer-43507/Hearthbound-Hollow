[sub_resource type="GDScript" id="GDScript_vrn4c"]
script/source = "extends Node

func _ready() -> void:
	timeout()

func timeout():
	if get_parent().get_parent().has_method(\"Damage\"):
		get_parent().get_parent().Damage(1)
	else:
		for i in get_parent().get_parent().get_children():
			if i.name == \"Health\":
				i.Damage(1)
	get_tree().create_timer(2).timeout.connect(timeout)
"

[resource]
script = ExtResource("1_e8pp2")
